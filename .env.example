# "offline" runs with no API key (deterministic local components).
# "openai" uses any OpenAI-compatible API: OpenAI, Azure OpenAI, vLLM, Ollama.
HRA_PROVIDER=offline

HRA_OPENAI_API_KEY=
# HRA_OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
HRA_CHAT_MODEL=gpt-4o-mini
HRA_EMBEDDING_MODEL=text-embedding-3-small

HRA_TOP_K=4
HRA_MIN_RELEVANCE=0.5
